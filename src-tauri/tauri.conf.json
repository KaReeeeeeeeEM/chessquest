{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ChessQuest",
  "version": "0.9.3",
  "identifier": "com.chessquest.club",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ChessQuest",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://lichess.org"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./macos-widget/App.entitlements",
      "files": {
        "PlugIns/TauriWidgetExtension.appex": "./macos-widget/build/Build/Products/Release/TauriWidgetExtension.appex"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMjlBM0JFM0ZEMEI0MEQKUldRTnROQS92cU1wekJRT3U3cHlRS1RkNFZGenhxVmUzNkQwRnNFTnZhSnk3YlpNQ0pIbGpseDMK",
      "endpoints": [
        "https://github.com/KaReeeeeeeeEM/chessquest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "widgets": {
      "appGroup": "group.com.chessquest.club",
      "transport": "widgetContainer",
      "extensionBundleId": "com.chessquest.club.widgetkit"
    }
  }
}
